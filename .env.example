# =====================================================================
# Frontend (static site on Vercel / Netlify)
# =====================================================================

# Backend API hosted on Render. Actual value is hardcoded in config.js
# (API_BASE_URL) and used by every page.
API_BASE_URL=https://research-api-lioc.onrender.com


# =====================================================================
# Backend (Render) env vars REQUIRED so the hosted frontend can call it
# =====================================================================

# Add your frontend's domain(s), comma-separated. These MUST be exact
# (no trailing slash) and MUST include the deployed URL, e.g.:
#   https://my-frontend.vercel.app,https://my-frontend.netlify.app
CORS_ORIGINS=https://my-frontend.vercel.app

# Allow the auth cookie to be stored/sent across sites (Vercel -> Render).
# "lax" keeps localhost dev working; use "none" in production.
COOKIE_SAMESITE=none

# Must be true in production (Render serves HTTPS).
COOKIE_SECURE=true