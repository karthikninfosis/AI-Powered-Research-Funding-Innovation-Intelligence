{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://research-api-lioc.onrender.com/api/:path*"
    },
    {
      "source": "/funding/:path*",
      "destination": "https://research-api-lioc.onrender.com/funding/:path*"
    }
  ]
}